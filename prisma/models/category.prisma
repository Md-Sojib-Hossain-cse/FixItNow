model Categories{
    id String @id @default(uuid())
    name String @db.VarChar(255) @unique
    slug String @db.VarChar(255) @unique
    description String?
    icon String?
    isDeleted Boolean? @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    services Services[]
    
    @@map("categories")
}