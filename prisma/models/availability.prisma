model Availability{
    id String @id @default(uuid())
    technicianProfile TechnicianProfiles @relation(fields : [technicianProfileId] , references : [id])
    technicianProfileId String
    day DateTime
    startTime DateTime
    endTime DateTime
    isBooked Boolean @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    booking Bookings?

    @@map("availabilities")
}