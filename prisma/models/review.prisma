model Reviews {
    id String @id @default(uuid())

    customer Users @relation(fields : [customerId] , references : [id])
    customerId String
    technicianProfile TechnicianProfiles @relation(fields : [technicianProfileId] , references : [id])
    technicianProfileId String
    booking Bookings @relation(fields : [bookingId] , references : [id])
    bookingId String @unique
    rating Decimal @db.Decimal(8,2)
    comment String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    
    @@map("reviews")
}